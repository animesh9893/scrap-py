# Copy to .env (gitignored) for local runs: scrape.py reads it on start. Variables already set in the environment
# win. On GitHub Actions the workflow's inputs set these instead, and PROXIES comes from the repo secret.
#
# No LinkedIn login: the scraper only reads LinkedIn's public (logged-out) pages. Scraping while signed in breaks
# LinkedIn's User Agreement and gets accounts restricted, so there is no username / password setting.

# Search
SEARCH_TERM=software engineer
LOCATION=Bengaluru
SEARCH_NAME=
HOURS_OLD=24
RESULTS=30
SORT=recent
DISTANCE=50

# Filters (comma-separated; empty = no filter)
JOB_TYPE=
EXPERIENCE=
EXCLUDE=
COMPANY_IDS=
EASY_APPLY=false
SCAN_LIMIT=

# Proxies, for when LinkedIn rate-limits you (429s): user:pass@host:port,host2:port
PROXIES=

OUT_DIR=out

# Supabase: the Postgres connection string (Project settings → Database → Connection string → URI; the session
# pooler works from GitHub Actions). Empty = files only. DRY_RUN=true skips saving even when it's set.
DATABASE_URL=
DRY_RUN=false

# single: the search above. plan: the due searches from the search_keywords × locations lists (needs DATABASE_URL).
# plan-only: print what plan would search.
MODE=single
MAX_TASKS=4
DEFAULT_INTERVAL_HOURS=2
TIME_BUDGET_MINUTES=8
SKIP_KNOWN=
KNOWN_DAYS=7
CATEGORY=
EXPIRE_DAYS=7
